{
  "name": "@codepilot/local-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Fastify-based local Agent API server for CodePilot Local",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codepilot/database": "workspace:*",
    "@codepilot/file-engine": "workspace:*",
    "@codepilot/shared": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
